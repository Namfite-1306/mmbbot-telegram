TELEGRAM_BOT_TOKEN=PUT_YOUR_BOTFATHER_TOKEN_HERE
SIGNAL_PROVIDER=mock
DATABASE_PATH=data/fintech_bot.db
TIMEZONE=Asia/Ho_Chi_Minh
LOG_LEVEL=INFO
MAX_TICKERS_PER_MESSAGE=10
DIGEST_TIME=17:30
# Optional: a private admin chat to receive EOD failure/recovery alerts.
ADMIN_CHAT_ID=

# Disabled by default. Use --run-alert-once for a manual run.
ENABLE_MOCK_ALERT_SCHEDULER=false
MOCK_ALERT_INTERVAL_SECONDS=300

# Read-only market data. Do not commit real credentials.
DNSE_API_KEY=PUT_YOUR_DNSE_API_KEY_HERE
DNSE_API_SECRET=PUT_YOUR_DNSE_API_SECRET_HERE
